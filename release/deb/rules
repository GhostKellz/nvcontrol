#!/usr/bin/make -f
# nvcontrol Debian build rules

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/.cargo
export RUSTUP_TOOLCHAIN = 1.98.1
export CARGO_TARGET_DIR = $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	cargo build --release --bin nvctl
	cargo build --release --bin nvcontrol --features gui

override_dh_auto_install:
	# Install binaries
	install -Dm755 $(CARGO_TARGET_DIR)/release/nvctl debian/nvcontrol/usr/bin/nvctl
	install -Dm755 $(CARGO_TARGET_DIR)/release/nvcontrol debian/nvcontrol/usr/bin/nvcontrol

	# Install desktop file
	install -Dm644 assets/nvcontrol.desktop debian/nvcontrol/usr/share/applications/nvcontrol.desktop

	install -Dm644 assets/app-icons/nvidia.png debian/nvcontrol/usr/share/icons/hicolor/512x512/apps/nvcontrol.png
	install -Dm644 completions/nvctl.bash debian/nvcontrol/usr/share/bash-completion/completions/nvctl
	install -Dm644 completions/_nvctl debian/nvcontrol/usr/share/zsh/site-functions/_nvctl
	install -Dm644 completions/nvctl.fish debian/nvcontrol/usr/share/fish/vendor_completions.d/nvctl.fish

	# Install systemd user services
	install -Dm644 release/arch/nvcontrol-monitor.service debian/nvcontrol/usr/lib/systemd/user/nvcontrol-monitor.service
	install -Dm644 release/arch/nvcontrol-game-profile-auto.service debian/nvcontrol/usr/lib/systemd/user/nvcontrol-game-profile-auto.service

	# Install documentation
	install -Dm644 README.md debian/nvcontrol/usr/share/doc/nvcontrol/README.md

	# Install man page
	install -Dm644 man/nvctl.1 debian/nvcontrol/usr/share/man/man1/nvctl.1

override_dh_auto_test:
	# Skip tests that require GPU hardware
	cargo test --release --lib -- --skip hardware --skip nvml

override_dh_auto_clean:
	cargo clean || true
	rm -rf $(CARGO_HOME)
